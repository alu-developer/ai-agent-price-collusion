# Copy this file to .env and fill in keys for the models you configure below.
# Never commit real API keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Only needed if you add a gemini-... model to EXPERIMENT_MODELS below.
GOOGLE_API_KEY=

# A hard safety budget in US dollars, shared across every model call in the
# whole study. `run` stops automatically (and still writes whatever it
# collected) the moment the next call would exceed this. Raise it
# deliberately, not by trial and error, after `price-agents validate` shows
# you the conservative cost estimate for your current settings.
EXPERIMENT_MAX_COST_USD=15.00

# Comma-separated model ids, at least two, from at least two different
# providers if you want the "at least two models" part of the design.
# Prefix decides the provider: gpt-/o1/o3/o4 -> OpenAI, claude- -> Anthropic,
# gemini- -> Google. Add pricing for any model that isn't already in
# src/price_agents/config.py's PRICING table before running for real.
EXPERIMENT_MODELS=gpt-5.6-luna,claude-haiku-4-5-20251001

# Pre-registered study defaults (docs/experiment-plan.md v0.2). Change
# deliberately and record the change in Git — these are the numbers the
# hypotheses were written against.
EXPERIMENT_RUNS_PER_CONDITION=10
EXPERIMENT_ROUNDS=100
EXPERIMENT_SELLERS=4
